# ──────────────────────────────────────────────
# MEXC Telegram Signal Bot — Environment Config
# Copy to .env and fill in your values.
# ⚠️  NEVER commit .env to version control!
# ──────────────────────────────────────────────

# ── MEXC Credentials ──────────────────────────
# Method 1: API Key + Secret (recommended for bots)
# Generate these at MEXC → API Management → Create API Key
MEXC_KEY=
MEXC_SECRET_KEY=

# Method 2: Browser WEB token (legacy — get from browser DevTools, starts with "WEB...")
# Leave blank if using Method 1 above
# MEXC_AUTH_TOKEN=

# ── Telegram ──────────────────────────────────
# Bot API token from @BotFather
TELEGRAM_BOT_TOKEN=

# Comma-separated list of allowed channel/chat IDs (numeric) or @usernames
# Example: -1001234567890,@signals_channel
ALLOWED_CHANNELS=

# Subset of ALLOWED_CHANNELS using the queue + operator-confirmation flow.
# Signals on these channels are queued (NOT placed until "CONFIRM ORDERS").
# Allowed channels NOT listed here place orders automatically.
# Leave empty to auto-place on ALL allowed channels.
#CONFIRM_CHANNELS=

# ── Trading Settings ──────────────────────────
# Default leverage (1-200)
DEFAULT_LEVERAGE=10

# Margin mode: 1 = isolated (default), 2 = cross
OPEN_TYPE=1

# ── Risk Management ──────────────────────────
# Risk per trade as decimal (0.01 = 1% of equity)
RISK_PERCENT=0.01

# Default TP:SL ratio when signal has no TP (1.5 = 1.5R)
DEFAULT_TP_RATIO=1.5

# Maximum number of concurrent open positions
MAX_CONCURRENT_TRADES=5

# Maximum notional value per trade in USDT
MAX_NOTIONAL_PER_TRADE=10000

# ── Operational ───────────────────────────────
# Dry run mode (true = parse/size but don't submit orders)
DRY_RUN=true

# Master trading switch (false = disable all order submission)
TRADING_ENABLED=true

# Log level: SILENT, ERROR, WARN, INFO, DEBUG
LOG_LEVEL=INFO

# Base currency for equity (default: USDT)
BASE_CURRENCY=USDT

# Path to state file for idempotency tracking
STATE_FILE_PATH=./bot-state.json

# ── API Rate Limiting ────────────────────────
# Token-bucket limiter applied to EVERY MEXC API call.
# ORDER_RATE_CAPACITY: max requests fired immediately in a burst ("as fast as
#   possible") before throttling kicks in. Default 3.
# ORDER_RATE_INTERVAL_MS: spacing between requests after the burst is spent;
#   sustained rate ≈ 1000/interval req/s. Default 200 (≈5 req/s).
# Lower capacity if you still hit MEXC code 513; raise for more burst.
ORDER_RATE_CAPACITY=3
ORDER_RATE_INTERVAL_MS=200

# Directory for persistent log files (signals-*.log, trades-*.log, bot-*.log)
# Rotates daily — files older than LOG_RETENTION_DAYS are auto-deleted
LOG_DIR=./logs

# Number of days to retain log files before auto-deleting (default: 90)
LOG_RETENTION_DAYS=90

# ── Position-Close Notifications ─────────────
# Telegram channel/chat ID (numeric or @username) that receives a message
# whenever a position closes, showing realized PNL (+ %), available balance
# and equity after the close. Leave empty to disable.
# Example: -1001234567890 or @pnl_channel
PNL_NOTIFICATION_CHANNEL=

# How often (seconds) to poll MEXC for closed positions (min 5, default 30)
POSITION_MONITOR_INTERVAL_SECONDS=30

# ── Periodic Position Summary ────────────────
# Channel/chat ID that receives a summary of open positions (with current /
# max / min PNL) every SUMMARY_INTERVAL_HOURS. Leave empty to reuse
# PNL_NOTIFICATION_CHANNEL.
# Example: -1001234567890 or @summary_channel
SUMMARY_NOTIFICATION_CHANNEL=

# How often (hours) to send the position summary (default 8)
SUMMARY_INTERVAL_HOURS=8

# Trailing window (hours) for PNL max/min stats shown in the summary (default 4)
SUMMARY_WINDOW_HOURS=4

# ── Fee Optimization ─────────────────────────
# When true, take-profit and stop-loss orders use LIMIT (maker) order type
# instead of MARKET (taker). Can reduce or eliminate TP/SL fees on exchanges
# that offer 0% maker fees. Applies to market entries immediately; for plan
# (trigger) entries, TPs are deferred and placed as limit orders when the
# position opens. SL is always attached for safety.
USE_LIMIT_TP_SL=false

# When true, position closes (manual /close, reverse) are attempted as LIMIT
# (maker) orders at the best bid/ask instead of MARKET (taker). Maker fills pay
# the maker fee (0.02%, and often 0% during MEXC promos) instead of the taker
# fee (0.05%). A maker close isn't guaranteed to fill instantly, so the bot
# waits a short grace period (~2.5s) then falls back to a market close.
USE_MAKER_CLOSE=false

# When true, signals with multiple TP targets (TP1/TP2/TP3) split the
# volume across them using partial limit TP orders instead of separate
# entry orders. This saves (N-1) entry taker fees. Default false — only
# the first TP is used, resulting in a single entry order.
SPLIT_MULTI_TP=false

# ── Signal Resolver (info-only) ──────────────
# Comma-separated list of Telegram channel/chat IDs whose signals are
# monitored for TP/SL hits but NOT traded. Posts resolution updates when
# targets are reached. Useful for tracking external signal performance.
SIGNAL_RESOLVER_CHANNELS=

# How often (seconds) to poll tickers for signal resolution checks (min 5, default 15)
SIGNAL_RESOLVER_INTERVAL_SECONDS=15
